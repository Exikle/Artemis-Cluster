# System
.DS_Store
Thumbs.db
.private/

# Tools
.venv/

# Kubernetes
*.kubeconfig
kubeconfig
talosconfig

# Secrets
*.crt
*.iso
*.key
*.pem
# Local agent env — MCP bearer tokens, sourced from 1Password via `just ai env`
.env

# AI — what is tracked under .claude/ is decided by .claude/.gitignore, not here

# Local scratch backups (may contain private data, never commit)
.backups/

# Stray SQLite store from running the memini CLI in this directory
memini.db

# OpenTofu — state IS committed, deliberately, and only ever as ciphertext
# (OpenTofu native aes_gcm encryption). A pre-commit guard refuses to commit a
# plaintext .tfstate, so this must NOT be ignored. Backups and plans still are.
.terraform/
*.tfstate.backup
*.tfstate.*.backup
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ansible — collections are installed from requirements.yml, not committed
ansible/collections/
*.retry
