{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/kimi-k3",
  "instructions": [".agents/instructions/*.md"],
  "permission": {
    "bash": {
      "*": "allow",
      "*kubectl apply*": "deny",
      "*kubectl delete*": "ask",
      "*helm install*": "deny",
      "*helm upgrade*": "deny",
      "*helm uninstall*": "deny",
      "*helm rollback*": "deny",
      "*flux delete*": "ask",
      "*flux uninstall*": "ask",
      "*talosctl patch machineconfig*": "deny",
      "*talosctl reset*": "ask",
      "*talosctl wipe*": "ask",
      "git add .": "deny",
      "git add -A*": "deny",
      "git push*--force*": "ask"
    }
  },
  "mcp": {
    "memini": {
      "type": "remote",
      "url": "https://memini.dcunha.io/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:MEMINI_API_KEY}",
        "X-Memini-Namespace": "homelab/Artemis-Cluster"
      }
    },
    "litellm-general": {
      "type": "remote",
      "url": "https://litellm.dcunha.io/general/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:LITELLM_API_KEY}"
      }
    },
    "litellm-media": {
      "type": "remote",
      "url": "https://litellm.dcunha.io/media/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:LITELLM_API_KEY}"
      }
    },
    "litellm-ops": {
      "type": "remote",
      "url": "https://litellm.dcunha.io/ops/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:LITELLM_API_KEY}"
      }
    }
  }
}
