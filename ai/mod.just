# Agent tooling — opencode / Claude routing helpers

[private]
default:
    @just ai --list

# Regenerate .env with MCP bearer tokens from 1Password (gitignored)
[group('ai')]
env:
    #!/usr/bin/env bash
    set -euo pipefail
    # In a just module, justfile_directory() is the ROOT justfile's dir
    # (the repo root) — not ai/. Do not append `..` here; that writes the
    # secret to $HOME.
    cd "{{ justfile_directory() }}"
    umask 077
    {
      echo "# Generated by \`just ai env\` — gitignored, do not commit."
      echo "LITELLM_API_KEY=$(op read 'op://artemis/litellm/MASTER_KEY')"
      echo "MEMINI_API_KEY=$(op read 'op://artemis/memini/MEMINI_API_KEY')"
    } > .env
    echo "wrote .env ($(wc -l < .env) lines, mode $(stat -c %a .env))"
