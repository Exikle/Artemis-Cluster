{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#3.0.0",
    ":automergePr",
    ":timezone(America/Toronto)",
  ],
  suppressNotifications: ["prEditedNotification", "prIgnoreNotification"],
  // Squash-merge so Forgejo creates one merge commit it can sign with the
  // instance SSH key (MERGES=always). No platformCommit / local GPG signing —
  // the instance is the sole signer for bot commits (Model A).
  automergeStrategy: "squash",
  schedule: ["at any time"],
  // Renovate's tekton manager ships with an empty managerFilePatterns, so it is
  // inert until scoped explicitly, and the home-operations preset does not extend
  // it. It reads spec.steps[].image / spec.sidecars[].image / spec.stepTemplate
  // .image and StepAction spec.image structurally, without needing `# renovate:`
  // annotations — so those are deliberately absent in this directory. Keep the
  // scope narrow: the extractor ignores kind/apiVersion and would happily probe
  // unrelated manifests.
  tekton: {
    managerFilePatterns: ["kubernetes/apps/forgejo/tekton-runner/library/**/*.yaml"],
  },
  packageRules: [
    {
      // The cluster is on a Talos prerelease (v1.14.0-beta.0). Renovate follows the
      // prerelease stream once currentValue is unstable, and factory.talos.dev/versions
      // lists betas — so with automerge on, a beta.1 release would merge itself and
      // tuppr would drain and roll all six nodes unattended. Keep Talos bumps manual
      // until the cluster is back on a stable version.
      description: "Never automerge Talos — tuppr rolls the cluster on merge",
      matchDatasources: ["custom.talos-factory"],
      matchPackageNames: ["siderolabs/talos"],
      automerge: false,
    },
    {
      description: "Disable artifact actions v4+ — incompatible with Forgejo",
      matchManagers: ["github-actions"],
      matchPackageNames: ["actions/upload-artifact", "actions/download-artifact"],
      enabled: false,
    },
    // Auto-merge
    {
      description: "Auto-merge all container digests",
      matchDatasources: ["docker"],
      automerge: true,
      matchUpdateTypes: ["digest"],
      ignoreTests: false,
    },
    {
      description: "Auto-merge Forgejo Actions",
      matchManagers: ["github-actions"],
      automerge: true,
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Auto-merge trusted Forgejo Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: ["/^actions\\//", "/^renovatebot\\//"],
      automerge: true,
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "1 minute",
      ignoreTests: true,
    },
    {
      description: "Auto-merge Grafana dashboards",
      matchDatasources: ["custom.grafana-dashboards"],
      matchUpdateTypes: ["major"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    {
      description: "Auto-merge all patch updates",
      matchUpdateTypes: ["patch"],
      automerge: true,
      ignoreTests: false,
    },
    {
      description: "Auto-merge all minor updates",
      matchUpdateTypes: ["minor"],
      automerge: true,
      ignoreTests: false,
    },
    // Groups
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Rook-Ceph Group",
      groupName: "rook-ceph",
      matchDatasources: ["docker", "helm"],
      matchPackageNames: ["/rook-ceph/", "/rook-ceph-cluster/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Kubernetes Group",
      groupName: "kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/siderolabs\\/kubelet/",
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-scheduler/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Cilium Group",
      groupName: "cilium",
      matchDatasources: ["docker"],
      matchPackageNames: ["/cilium\\/charts\\/cilium/", "/charts-mirror\\/cilium/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Envoy Gateway Group",
      groupName: "envoy-gateway",
      matchDatasources: ["docker"],
      matchPackageNames: ["/envoyproxy\\/gateway-helm/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Toolhive Group",
      groupName: "toolhive",
      matchDatasources: ["docker"],
      matchPackageNames: ["/toolhive-operator/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    // Labels
    {
      description: "Label major updates",
      matchUpdateTypes: ["major"],
      addLabels: ["type/major", "priority/high"],
    },
    {
      description: "Label minor updates",
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor", "priority/medium"],
    },
    {
      description: "Label patch updates",
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch", "priority/low"],
    },
    {
      description: "Label digest updates",
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
    {
      description: "Label container updates",
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      description: "Label Helm updates",
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      description: "Label GitHub Release updates",
      matchDatasources: ["github-releases", "github-tags"],
      addLabels: ["renovate/github-release"],
    },
    {
      description: "Label Forgejo Actions updates",
      matchManagers: ["github-actions"],
      addLabels: ["renovate/forgejo-action"],
    },
  ],
}
