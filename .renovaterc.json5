{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#8.1.0",
    "github>home-operations/renovate-presets//apps/cnpg.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/searxng.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#8.1.0",
    ":automergePr",
    ":timezone(America/Toronto)",
  ],
  suppressNotifications: ["prEditedNotification", "prIgnoreNotification"],
  automergeStrategy: "squash",
  schedule: ["at any time"],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 4am on the first day of the month"],
  },
  tekton: {
    managerFilePatterns: ["kubernetes/apps/forgejo/tekton-runner/library/**/*.yaml"],
  },
  terraform: {
    managerFilePatterns: ["terraform/**/*.tf"],
  },
  "ansible-galaxy": {
    managerFilePatterns: ["ansible/requirements.yml"],
  },
  customManagers: [
    {
      customType: "regex",
      description: "npm packages pinned inside MCP server container commands — invisible to the npm manager because there is no package.json",
      managerFilePatterns: ["kubernetes/apps/cortex/litellm/mcp/**/mcpserver.yaml"],
      matchStrings: [
        "(?<depName>@[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)",
      ],
      datasourceTemplate: "npm",
    },
  ],
  packageRules: [
    {
      description: "forgejo-mcp: hold at 0.1.7 — resources/http-fixed.mjs patches its internals and a bump breaks the imports silently",
      matchDatasources: ["npm"],
      matchPackageNames: ["@ric_/forgejo-mcp"],
      automerge: false,
      dependencyDashboardApproval: true,
      addLabels: ["hold/upstream", "area/agents"],
    },
    {
      description: "Never automerge Talos — tuppr rolls the cluster on merge",
      matchPackageNames: ["siderolabs/talos"],
      automerge: false,
    },
    {
      description: "Never automerge pocket-id — the operator halts on an unsupported version",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/pocket-id/pocket-id"],
      automerge: false,
    },
    {
      description: "Never automerge litellm — v1.99.0 silently flipped the MCP allow_all_keys default and emptied every tool list",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/berriai/litellm"],
      automerge: false,
    },
    {
      description: "Eco: track only promoted -beta tags, not CI release/staging builds",
      matchDatasources: ["docker"],
      matchPackageNames: ["strangeloopgames/eco-game-server"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-beta$",
    },
    {
      description: "Disable artifact actions v4+ — incompatible with Forgejo",
      matchManagers: ["github-actions"],
      matchPackageNames: ["actions/upload-artifact", "actions/download-artifact"],
      enabled: false,
    },
    {
      description: "Tekton runner built-ins are not real repositories",
      matchManagers: ["github-actions"],
      matchPackageNames: ["tekton/setup", "tekton/pipeline"],
      enabled: false,
    },
    {
      description: "Never automerge OpenTofu providers — these change real hardware",
      matchManagers: ["terraform"],
      automerge: false,
      addLabels: ["area/terraform"],
    },
    {
      description: "Never automerge Ansible collections — these change real hardware",
      matchManagers: ["ansible-galaxy"],
      automerge: false,
      addLabels: ["area/ansible"],
    },
    {
      description: "Auto-merge all container digests",
      matchDatasources: ["docker"],
      automerge: true,
      matchUpdateTypes: ["digest"],
      ignoreTests: false,
    },
    {
      description: "Auto-merge Forgejo Actions",
      matchManagers: ["github-actions"],
      automerge: true,
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Auto-merge trusted Forgejo Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: ["/^actions\\//", "/^renovatebot\\//"],
      automerge: true,
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "1 minute",
      ignoreTests: true,
    },
    {
      description: "Auto-merge Grafana dashboards",
      matchDatasources: ["custom.grafana-dashboards"],
      matchUpdateTypes: ["major"],
      automerge: true,
      ignoreTests: true,
    },
    {
      description: "Auto-merge all patch updates",
      matchUpdateTypes: ["patch"],
      automerge: true,
      ignoreTests: false,
    },
    {
      description: "Auto-merge all minor updates, except breaking 0.x minors (zer0ver)",
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "!/^v?0\\./",
      automerge: true,
      ignoreTests: false,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Never automerge rook-ceph — the chart default can move the Ceph version",
      groupName: "rook-ceph",
      matchDatasources: ["docker", "helm"],
      matchPackageNames: ["/rook-ceph/", "/rook-ceph-cluster/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
      automerge: false,
    },
    {
      description: "Kubernetes Group",
      groupName: "kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/siderolabs\\/kubelet/",
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-scheduler/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Cilium Group",
      groupName: "cilium",
      matchDatasources: ["docker"],
      matchPackageNames: ["/cilium\\/charts\\/cilium/", "/charts-mirror\\/cilium/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Envoy Gateway Group",
      groupName: "envoy-gateway",
      matchDatasources: ["docker"],
      matchPackageNames: ["/envoyproxy\\/gateway-helm/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Label major updates",
      matchUpdateTypes: ["major"],
      addLabels: ["type/major", "priority/high"],
    },
    {
      description: "Label minor updates",
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor", "priority/medium"],
    },
    {
      description: "Label patch updates",
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch", "priority/low"],
    },
    {
      description: "Label digest updates",
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
    {
      description: "Label container updates",
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      description: "Label Helm updates",
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      description: "Label GitHub Release updates",
      matchDatasources: ["github-releases", "github-tags"],
      addLabels: ["renovate/github-release"],
    },
    {
      description: "Label Forgejo Actions updates",
      matchManagers: ["github-actions"],
      addLabels: ["renovate/forgejo-action"],
    },
  ],
}
