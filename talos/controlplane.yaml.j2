---
machine:
  ca:
    crt: op://infrastructure/talos/MACHINE_CA_CRT
    key: op://infrastructure/talos/MACHINE_CA_KEY
cluster:
  controlPlane:
    endpoint: https://artemis.dcunha.io:6443
  ca:
    crt: op://infrastructure/talos/CLUSTER_CA_CRT
    key: op://infrastructure/talos/CLUSTER_CA_KEY
  aggregatorCA:
    crt: op://infrastructure/talos/AGGREGATOR_CA_CRT
    key: op://infrastructure/talos/AGGREGATOR_CA_KEY
  serviceAccount:
    key: op://infrastructure/talos/SERVICE_ACCOUNT_KEY
  etcd:
    ca:
      crt: op://infrastructure/talos/ETCD_CA_CRT
      key: op://infrastructure/talos/ETCD_CA_KEY
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
    advertisedSubnets:
      - 10.10.99.0/24
---
apiVersion: v1alpha1
kind: KubeNodeConfig
labels:
  node-role.kubernetes.io/control-plane: ""
---
apiVersion: v1alpha1
kind: KubeProxyConfig
enabled: false
image: registry.k8s.io/kube-proxy:v1.37.0
---
apiVersion: v1alpha1
kind: KubeCoreDNSConfig
enabled: false
image: registry.k8s.io/coredns/coredns:v1.14.7
---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
image: registry.k8s.io/kube-apiserver:v1.37.0
extraArgs:
  enable-aggregator-routing: "true"
  feature-gates: HPAScaleToZero=true
certExtraSANs:
  - 127.0.0.1
  - 10.10.99.99
  - artemis.dcunha.io
---
apiVersion: v1alpha1
kind: KubeAuthorizerConfig
name: node
type: Node
---
apiVersion: v1alpha1
kind: KubeAuthorizerConfig
name: rbac
type: RBAC
---
apiVersion: v1alpha1
kind: KubeAuthenticationConfig
configuration:
  anonymous:
    enabled: true
    conditions:
      - path: /livez
      - path: /readyz
      - path: /healthz
  jwt: []
---
apiVersion: v1alpha1
kind: KubeAdmissionControlConfig
name: PodSecurity
configuration:
  apiVersion: pod-security.admission.config.k8s.io/v1alpha1
  kind: PodSecurityConfiguration
  defaults:
    audit: restricted
    audit-version: latest
    enforce: baseline
    enforce-version: latest
    warn: restricted
    warn-version: latest
  exemptions:
    namespaces:
      - kube-system
    runtimeClasses: []
    usernames: []
---
apiVersion: v1alpha1
kind: KubeAuditPolicyConfig
configuration:
  apiVersion: audit.k8s.io/v1
  kind: Policy
  rules:
    - level: Metadata
---
apiVersion: v1alpha1
kind: KubeEtcdEncryptionConfig
config:
  resources:
    - resources:
        - secrets
      providers:
        - secretbox:
            keys:
              - name: key2
                secret: op://infrastructure/talos/SECRETBOX_ENCRYPTION_SECRET
        - identity: {}
---
apiVersion: v1alpha1
kind: KubeControllerManagerConfig
image: registry.k8s.io/kube-controller-manager:v1.37.0
extraArgs:
  bind-address: 0.0.0.0
  feature-gates: HPAScaleToZero=true
---
apiVersion: v1alpha1
kind: KubeSchedulerConfig
image: registry.k8s.io/kube-scheduler:v1.37.0
extraArgs:
  bind-address: 0.0.0.0
config:
  profiles:
    - schedulerName: default-scheduler
      plugins:
        score:
          disabled:
            - name: ImageLocality
      pluginConfig:
        - name: PodTopologySpread
          args:
            defaultingType: List
            defaultConstraints:
              - maxSkew: 1
                topologyKey: kubernetes.io/hostname
                whenUnsatisfiable: ScheduleAnyway
---
apiVersion: v1alpha1
kind: KubeTalosAPIAccessConfig
allowedRoles:
  - os:admin
allowedKubernetesNamespaces:
  - forgejo
  - system-upgrade
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: net0
selector:
  match: mac(link.permanent_addr).startsWith("6c:4b:90")
# --- miroir partition layout ---
# nvme0n1p1 (r-miroir) is the lvmthin PV backing the miroir "nvme" pool. It
# grows to fill the disk; the old rook partition was dropped on 2026-09-05.
#
# GPT partitions only grow forward, which is why miroir was deliberately
# allocated first. Growing it here does not resize the LVM PV or the thin pool
# -- pvresize + lvextend are manual and miroir will not do them.
---
apiVersion: v1alpha1
kind: RawVolumeConfig
name: miroir
provisioning:
  diskSelector:
    match: disk.model == "SAMSUNG MZVLW256HEHP-000L7" && !system_disk
  grow: true
  minSize: 135GiB
