---
machine:
  ca:
    crt: op://infrastructure/talos/MACHINE_CA_CRT
    key: op://infrastructure/talos/MACHINE_CA_KEY
cluster:
  controlPlane:
    endpoint: https://artemis.dcunha.io:6443
  ca:
    crt: op://infrastructure/talos/CLUSTER_CA_CRT
    key: op://infrastructure/talos/CLUSTER_CA_KEY
  aggregatorCA:
    crt: op://infrastructure/talos/AGGREGATOR_CA_CRT
    key: op://infrastructure/talos/AGGREGATOR_CA_KEY
  serviceAccount:
    key: op://infrastructure/talos/SERVICE_ACCOUNT_KEY
  etcd:
    ca:
      crt: op://infrastructure/talos/ETCD_CA_CRT
      key: op://infrastructure/talos/ETCD_CA_KEY
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
    advertisedSubnets:
      - 10.10.99.0/24
---
apiVersion: v1alpha1
kind: KubeNodeConfig
labels:
  node-role.kubernetes.io/control-plane: ""
---
apiVersion: v1alpha1
kind: KubeProxyConfig
enabled: false
image: registry.k8s.io/kube-proxy:v1.37.0
---
apiVersion: v1alpha1
kind: KubeCoreDNSConfig
enabled: false
image: registry.k8s.io/coredns/coredns:v1.14.7
---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
image: registry.k8s.io/kube-apiserver:v1.37.0
extraArgs:
  enable-aggregator-routing: "true"
  feature-gates: HPAScaleToZero=true
certExtraSANs:
  - 127.0.0.1
  - 10.10.99.99
  - artemis.dcunha.io
---
apiVersion: v1alpha1
kind: KubeAuthorizerConfig
name: node
type: Node
---
apiVersion: v1alpha1
kind: KubeAuthorizerConfig
name: rbac
type: RBAC
---
apiVersion: v1alpha1
kind: KubeAuthenticationConfig
configuration:
  anonymous:
    enabled: true
    conditions:
      - path: /livez
      - path: /readyz
      - path: /healthz
  jwt: []
---
apiVersion: v1alpha1
kind: KubeAdmissionControlConfig
name: PodSecurity
configuration:
  apiVersion: pod-security.admission.config.k8s.io/v1alpha1
  kind: PodSecurityConfiguration
  defaults:
    audit: restricted
    audit-version: latest
    enforce: baseline
    enforce-version: latest
    warn: restricted
    warn-version: latest
  exemptions:
    namespaces:
      - kube-system
    runtimeClasses: []
    usernames: []
---
apiVersion: v1alpha1
kind: KubeAuditPolicyConfig
configuration:
  apiVersion: audit.k8s.io/v1
  kind: Policy
  rules:
    - level: Metadata
---
apiVersion: v1alpha1
kind: KubeEtcdEncryptionConfig
config:
  resources:
    - resources:
        - secrets
      providers:
        - secretbox:
            keys:
              - name: key2
                secret: op://infrastructure/talos/SECRETBOX_ENCRYPTION_SECRET
        - identity: {}
---
apiVersion: v1alpha1
kind: KubeControllerManagerConfig
image: registry.k8s.io/kube-controller-manager:v1.37.0
extraArgs:
  bind-address: 0.0.0.0
  feature-gates: HPAScaleToZero=true
---
apiVersion: v1alpha1
kind: KubeSchedulerConfig
image: registry.k8s.io/kube-scheduler:v1.37.0
extraArgs:
  bind-address: 0.0.0.0
config:
  profiles:
    - schedulerName: default-scheduler
      plugins:
        score:
          disabled:
            - name: ImageLocality
      pluginConfig:
        - name: PodTopologySpread
          args:
            defaultingType: List
            defaultConstraints:
              - maxSkew: 1
                topologyKey: kubernetes.io/hostname
                whenUnsatisfiable: ScheduleAnyway
---
apiVersion: v1alpha1
kind: KubeTalosAPIAccessConfig
allowedRoles:
  - os:admin
allowedKubernetesNamespaces:
  - forgejo
  - system-upgrade
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: net0
selector:
  match: mac(link.permanent_addr).startsWith("6c:4b:90")
# --- Ceph + miroir partition layout (parallel operation) ---
# Applied per node, one at a time: drain and remove that node's OSD, clear
# nvme0n1, apply, then label the node storage.dcunha.io/miroir=true so the
# MiroirNodeGroup picks it up. Ceph stays healthy on the other two throughout.
#
# Carrying this on an unconverted node is safe. Talos refuses to partition a
# disk that is neither blank nor GPT (disk.go CheckDiskForProvisioning:
# "not empty, and not gpt => can't be used for partitioning"), and a whole-disk
# OSD probes as bluestore -- so both volumes stay unprovisioned rather than
# laying a GPT over live OSD data.
#
# Order is enforced by Talos (CompareVolumeConfigs), not by the order written
# here: non-growing partitions first, then smaller maxSize. miroir is bounded
# and non-growing so it is allocated FIRST, at the front of the disk; ceph is
# marked grow so it is allocated second, capped at 100GiB by maxSize.
#
# That order is what makes Ceph's space reclaimable later. GPT partitions only
# grow forward (grow.go: AvailablePartitionGrowth), so once Ceph is retired:
# remove the rook document, clear partition 2, then flip miroir to grow: true
# with no maxSize. Talos extends partition 1 into the freed tail on the next
# reconcile. One manual step remains: pvresize + extend the thin pool, since
# miroir does not grow a pool on its own.
#
# 100GiB of rook per node is 100GiB usable at 3x replication. Each OSD holds
# ~54GiB today (ceph osd df), and it shrinks as apps migrate off.
#
# The partition is named "rook", not "ceph", and that is load-bearing:
# ceph-volume's is_ceph_disk_member does `'ceph' in PARTLABEL`, so any label
# containing that substring is rejected as a legacy ceph-disk partition
# ("Used by ceph-disk") and Rook can never provision an OSD onto it.
---
apiVersion: v1alpha1
kind: RawVolumeConfig
name: miroir
provisioning:
  diskSelector:
    match: disk.model == "SAMSUNG MZVLW256HEHP-000L7" && !system_disk
  maxSize: 135GiB
---
apiVersion: v1alpha1
kind: RawVolumeConfig
name: rook
provisioning:
  diskSelector:
    match: disk.model == "SAMSUNG MZVLW256HEHP-000L7" && !system_disk
  grow: true
  maxSize: 100GiB
