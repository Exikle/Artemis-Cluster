---
# Talos v1.14 multi-document layout — NOT YET ACTIVE.
#
# Talos 1.14 is still at v1.14.0-beta.0 as of 2026-07-27. `machineconfig.yaml.j2`
# remains the live config and is rendered by `just talos render-config`. This file is
# the 1.14 translation of it, staged so the upgrade is a `git mv` plus a validation
# pass rather than a rewrite under time pressure.
#
# 1.14 does NOT force a big-bang migration: the release notes state the deprecated
# v1alpha1 fields stay supported, and where both sources are accepted the new document
# wins on conflict. Two pairs are mutually exclusive and will be REJECTED if both are
# present — `.cluster.discovery` vs `DiscoveryServiceConfig`, and
# `.machine.baseRuntimeSpecOverrides` vs `CRIBaseRuntimeSpecConfig`. So this can be
# adopted document-by-document after the upgrade if a big swap feels risky.
#
# VALIDATED: this file passes `talosctl validate -m metal` for both controlplane and
# worker roles under talosctl v1.14.0-beta.0 (run via `mise x talos@1.14.0-beta.0`, since
# the repo-pinned client is still 1.13.x and does not recognise these kinds). Validation
# is done with a per-node `provisioning` block appended — see below.
#
# Before activating:
#   1. resolve every TODO(1.14) marker
#   2. port nodes/*.yaml.j2: `machine.install` becomes an UnattendedInstallConfig document
#      carrying only `provisioning` (control planes `diskSelector.match:
#      disk.model == "Samsung SSD 860"` + `wipe: true`; workers `disk.dev_path == "/dev/vda"`
#      + `wipe: false`), and `machine.nodeLabels` becomes a KubeNodeConfig document with
#      `labels:`. Note the validator reports a missing diskSelector as
#      "provisioning.volumeSelector.match is required" — `volumeSelector` is the internal
#      field name and is NOT accepted in the config; use `diskSelector`.
#   3. apply to ONE worker first (talos-w-02), confirm, then roll the rest
#
# Known 1.14 behaviour changes that affect this cluster specifically:
#   - The EPHEMERAL volume (/var) defaults to `noexec` on NEW machines. Upgrades are not
#     affected, but a rebuilt node running workloads that exec binaries out of /var will
#     break. Opt out per-node with a VolumeConfig document if that bites.
#   - `ghcr.io/siderolabs/installer` is no longer published; the Image Factory path is
#     now `factory.talos.dev/metal-installer/<schematic>:<version>` (note: metal-installer,
#     not installer). The image below is already updated for this.
#   - `.machine.features.rbac` and `.machine.features.apidCheckExtKeyUsage` no longer
#     exist in the reduced v1alpha1 schema and have been dropped here.
version: v1alpha1
machine:
  token: op://kubernetes/talos/MACHINE_TOKEN
  ca:
    crt: op://kubernetes/talos/MACHINE_CA_CRT
    {% if ENV.IS_CONTROLLER %}
    key: op://kubernetes/talos/MACHINE_CA_KEY
    {% endif %}
  features:
    diskQuotaSupport: true
    {% if ENV.IS_CONTROLLER %}
    kubernetesTalosAPIAccess:
      enabled: true
      allowedRoles:
        - os:admin
      allowedKubernetesNamespaces:
        - forgejo
        - system-upgrade
    {% endif %}
cluster:
  token: op://kubernetes/talos/CLUSTER_TOKEN
  # PKI and cluster identity deliberately stay in v1alpha1. The KubeAPIServerCAConfig /
  # KubeAggregatorCAConfig / KubeServiceAccountConfig documents parse their material as
  # PEM, but the 1Password items hold base64-DER because that is what v1alpha1 expects —
  # migrating these would mean re-encoding every cert in the vault for no functional gain.
  # Upstream (onedr0p) made the same call. Same for clusterName / controlPlane.endpoint:
  # KubeClusterConfig exists, but leaving them here keeps the diff small.
  ca:
    crt: op://kubernetes/talos/CLUSTER_CA_CRT
    {% if ENV.IS_CONTROLLER %}
    key: op://kubernetes/talos/CLUSTER_CA_KEY
    {% endif %}
  clusterName: artemis-cluster
  controlPlane:
    {% if ENV.IS_CONTROLLER %}
    endpoint: https://artemis.dcunha.io:6443
    {% else %}
    endpoint: https://10.10.99.101:6443
    {% endif %}
  {% if ENV.IS_CONTROLLER %}
  aggregatorCA:
    crt: op://kubernetes/talos/AGGREGATOR_CA_CRT
    key: op://kubernetes/talos/AGGREGATOR_CA_KEY
  serviceAccount:
    key: op://kubernetes/talos/SERVICE_ACCOUNT_KEY
  etcd:
    ca:
      crt: op://kubernetes/talos/ETCD_CA_CRT
      key: op://kubernetes/talos/ETCD_CA_KEY
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
    advertisedSubnets:
      - 10.10.99.0/24
  {% endif %}
---
# Per-node `provisioning` (diskSelector / wipe) is layered on by the node patch files at
# migration time — control planes match on disk model and wipe, workers install to /dev/vda
# and do not. The 1.13 equivalents live under `machine.install` in nodes/*.yaml.j2 today.
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  # renovate: datasource=custom.talos-factory depName=siderolabs/talos
  image: factory.talos.dev/metal-installer/{{ ENV.SCHEMATIC }}:v1.14.0-beta.0
---
apiVersion: v1alpha1
kind: KubeletConfig
image: ghcr.io/siderolabs/kubelet:v1.36.3
config:
  allowedUnsafeSysctls:
    - "net.ipv6.conf.*"
  maxParallelImagePulls: 3
  serializeImagePulls: false
  shutdownGracePeriod: 90s
  shutdownGracePeriodCriticalPods: 60s
defaultRuntimeSeccompProfileEnabled: true
# TODO(1.14): `.machine.kubelet.extraMounts` (the /var/local/openebs rshared bind mount)
# and `.machine.kubelet.disableManifestsDirectory` have no documented equivalent in the
# v1.14.0-beta.0 reference — they appear in neither KubeletConfig nor KubeNodeConfig.
# The release notes fold "the rest of .machine.kubelet" into KubeNodeConfig and
# KubeCredentialProviderConfig without naming these two. Confirm against the 1.14.0
# stable reference before activating; losing the bind mount breaks openebs hostpath.
---
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeIP:
  validSubnets:
    - 10.10.99.0/24
labels:
  topology.kubernetes.io/region: artemis
  {% if ENV.IS_CONTROLLER %}
  node-role.kubernetes.io/control-plane: ""
  {% endif %}
# 1.14 lists the controlplane NoSchedule taint explicitly rather than defaulting it, so
# omitting `taints` here is what replaces `.cluster.allowSchedulingOnControlPlanes: true`.
# `taints` is a map (name: value:Effect), not a list — an empty list fails to decode.
taints: {}
---
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
  - address: 10.10.99.1
hostDNS:
  enabled: true
  forwardKubeDNSToHost: true
  resolveMemberNames: true
---
apiVersion: v1alpha1
kind: TimeSyncConfig
ntp:
  servers:
    - 10.10.99.1
    - time.cloudflare.com
---
apiVersion: v1alpha1
kind: SysctlConfig
params:
  fs.inotify.max_user_instances: "8192"
  fs.inotify.max_user_watches: "1048576"
  net.core.default_qdisc: fq
  net.core.rmem_max: "67108864"
  net.core.wmem_max: "67108864"
  net.ipv4.ip_local_port_range: 1024 65535
  net.ipv4.neigh.default.gc_thresh1: "4096"
  net.ipv4.neigh.default.gc_thresh2: "8192"
  net.ipv4.neigh.default.gc_thresh3: "16384"
  net.ipv4.ping_group_range: 0 2147483647
  net.ipv4.tcp_congestion_control: bbr
  net.ipv4.tcp_fastopen: "3"
  net.ipv4.tcp_mtu_probing: "1"
  net.ipv4.tcp_notsent_lowat: "131072"
  net.ipv4.tcp_rmem: 4096 87380 33554432
  net.ipv4.tcp_slow_start_after_idle: "0"
  net.ipv4.tcp_tw_reuse: "1"
  net.ipv4.tcp_window_scaling: "1"
  net.ipv4.tcp_wmem: 4096 65536 33554432
  sunrpc.tcp_max_slot_table_entries: "128"
  sunrpc.tcp_slot_table_entries: "128"
  user.max_user_namespaces: "11255"
  vm.nr_hugepages: "1024"
---
apiVersion: v1alpha1
kind: EtcFileConfig
name: nfsmount.conf
mode: 0o644
contents: |
  [ NFSMount_Global_Options ]
  nfsvers=4.2
  hard=True
  noatime=True
  nconnect=8
  rsize=1048576
  wsize=1048576
---
# The unprivileged-ports/icmp settings from the 1.13 `/etc/cri/conf.d` file are omitted:
# 1.14 exposes the Talos-managed containerd config under the reserved `customization`
# name, and a CRICustomizationConfig document may not reuse that name.
# TODO(1.14): confirm enable_unprivileged_ports / enable_unprivileged_icmp are still
# applied by default, or re-add them under a differently-named document.
apiVersion: v1alpha1
kind: CRICustomizationConfig
name: containerd
content: |
  [plugins."io.containerd.cri.v1.images"]
    discard_unpacked_layers = false
  [plugins."io.containerd.cri.v1.runtime"]
    device_ownership_from_security_context = true
---
apiVersion: v1alpha1
kind: KubePrismConfig
port: 7445
---
apiVersion: v1alpha1
kind: FilesystemTrimConfig
interval: 168h0m0s
---
apiVersion: v1alpha1
kind: WatchdogTimerConfig
device: /dev/watchdog0
timeout: 5m
---
apiVersion: v1alpha1
kind: DiscoveryIdentityConfig
clusterID: op://kubernetes/talos/CLUSTER_ID
clusterSecret: op://kubernetes/talos/CLUSTER_SECRET
---
apiVersion: v1alpha1
kind: KubeNetworkConfig
dnsDomain: cluster.local
podSubnets:
  - 10.42.0.0/16
serviceSubnets:
  - 10.43.0.0/16
{% if ENV.IS_CONTROLLER %}
---
apiVersion: v1alpha1
kind: KubeProxyConfig
enabled: false
---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
image: registry.k8s.io/kube-apiserver:v1.36.3
extraArgs:
  enable-aggregator-routing: "true"
  feature-gates: HPAScaleToZero=true
certExtraSANs:
  - 127.0.0.1
  - 10.10.99.99
  - artemis.dcunha.io
---
apiVersion: v1alpha1
kind: KubeAdmissionControlConfig
name: PodSecurity
configuration:
  apiVersion: pod-security.admission.config.k8s.io/v1alpha1
  kind: PodSecurityConfiguration
  defaults:
    audit: restricted
    audit-version: latest
    enforce: baseline
    enforce-version: latest
    warn: restricted
    warn-version: latest
  exemptions:
    namespaces:
      - kube-system
    runtimeClasses: []
    usernames: []
---
apiVersion: v1alpha1
kind: KubeAuditPolicyConfig
configuration:
  apiVersion: audit.k8s.io/v1
  kind: Policy
  rules:
    - level: Metadata
---
# New in this migration, not a translation of anything in the 1.13 config: restricts
# anonymous API access to the three health endpoints instead of leaving it broadly on.
apiVersion: v1alpha1
kind: KubeAuthenticationConfig
configuration:
  anonymous:
    enabled: true
    conditions:
      - path: /livez
      - path: /readyz
      - path: /healthz
  jwt: []
---
apiVersion: v1alpha1
kind: KubeAuthorizerConfig
name: node
type: Node
---
apiVersion: v1alpha1
kind: KubeAuthorizerConfig
name: rbac
type: RBAC
---
apiVersion: v1alpha1
kind: KubeEtcdEncryptionConfig
config:
  resources:
    - resources:
        - secrets
      providers:
        - secretbox:
            keys:
              - name: key2
                secret: op://kubernetes/talos/SECRETBOX_ENCRYPTION_SECRET
        - identity: {}
---
apiVersion: v1alpha1
kind: KubeControllerManagerConfig
image: registry.k8s.io/kube-controller-manager:v1.36.3
extraArgs:
  bind-address: 0.0.0.0
  feature-gates: HPAScaleToZero=true
---
apiVersion: v1alpha1
kind: KubeSchedulerConfig
image: registry.k8s.io/kube-scheduler:v1.36.3
extraArgs:
  bind-address: 0.0.0.0
config:
  profiles:
    - schedulerName: default-scheduler
      plugins:
        score:
          disabled:
            - name: ImageLocality
      pluginConfig:
        - name: PodTopologySpread
          args:
            defaultingType: List
            defaultConstraints:
              - maxSkew: 1
                topologyKey: kubernetes.io/hostname
                whenUnsatisfiable: ScheduleAnyway
---
apiVersion: v1alpha1
kind: KubeCoreDNSConfig
enabled: false
{% endif %}
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: net0
selector:
  {% if ENV.IS_CONTROLLER %}
  match: mac(link.permanent_addr).startsWith("6c:4b:90")
  {% else %}
  match: mac(link.permanent_addr).startsWith("bc:24:11")
  {% endif %}
---
apiVersion: v1alpha1
kind: BondConfig
name: bond0
links:
  - net0
bondMode: active-backup
---
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.1099
parent: bond0
vlanID: 1099
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: bond0.1099
clientIdentifier: mac
---
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.1152
parent: bond0
vlanID: 1152
