---
machine:
  type: worker
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
provisioning:
  diskSelector:
    match: disk.dev_path == "/dev/vda"
  wipe: false
---
apiVersion: v1alpha1
kind: KubeNodeConfig
labels:
  node.kubernetes.io/gpu: "true"
  node.kubernetes.io/gpu-tier: "arc"
  topology.kubernetes.io/zone: pantheon
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: "off"
hostname: talos-gpu-01
