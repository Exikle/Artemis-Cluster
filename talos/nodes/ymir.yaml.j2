---
machine:
  type: worker
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
provisioning:
  diskSelector:
    match: disk.model == "SPCC M.2 SSD" && disk.transport == "sata"
  wipe: true
---
apiVersion: v1alpha1
kind: KubeNodeConfig
labels:
  topology.kubernetes.io/zone: metal-04
  node.kubernetes.io/gpu-tier: "gen95"
annotations:
  network.cilium.io/ipv6-pod-cidr: fd00:42:1:6::/64
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: net0
selector:
  match: mac(link.permanent_addr) == "d8:5e:d3:00:ea:81"
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: "off"
hostname: ymir
---
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.1099
parent: bond0
vlanID: 1099
addresses:
  - address: fd00:10:10:99::204/64
