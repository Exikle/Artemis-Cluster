---
machine:
  type: controlplane
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
provisioning:
  diskSelector:
    match: disk.model == "SSDSC2KG240G8R" && disk.transport == "sata"
  wipe: true
---
apiVersion: v1alpha1
kind: KubeNodeConfig
labels:
  bgppolicy: enabled
  node.kubernetes.io/gpu-tier: "gen9"
  node.kubernetes.io/exclude-from-external-load-balancers: ""
  storage.dcunha.io/miroir: "true"
  topology.kubernetes.io/zone: metal-01
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: "off"
hostname: talos-cp-01
