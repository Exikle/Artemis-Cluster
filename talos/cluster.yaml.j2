---
version: v1alpha1
machine:
  token: op://infrastructure/talos/MACHINE_TOKEN
  ca:
    crt: op://infrastructure/talos/MACHINE_CA_CRT
  features:
    diskQuotaSupport: true
cluster:
  token: op://infrastructure/talos/CLUSTER_TOKEN
  clusterName: artemis-cluster
  controlPlane:
    endpoint: https://artemis.dcunha.io:6443
  ca:
    crt: op://infrastructure/talos/CLUSTER_CA_CRT
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  # renovate: datasource=custom.talos-factory depName=siderolabs/talos
  image: factory.talos.dev/installer/{{ ENV.SCHEMATIC }}:v1.14.0-rc.2
---
apiVersion: v1alpha1
kind: KubeletConfig
image: ghcr.io/siderolabs/kubelet:v1.36.4
config:
  allowedUnsafeSysctls:
    - "net.ipv6.conf.*"
  crashLoopBackOff:
    maxContainerRestartPeriod: 60s
  imageMaximumGCAge: 168h
  maxParallelImagePulls: 3
  serializeImagePulls: false
  shutdownGracePeriod: 90s
  shutdownGracePeriodCriticalPods: 60s
defaultRuntimeSeccompProfileEnabled: true
---
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeIP:
  validSubnets:
    - 10.10.99.0/24
labels:
  topology.kubernetes.io/region: artemis
taints: {}
annotations:
  tuppr.home-operations.com/factory-url: factory.talos.dev/installer
  tuppr.home-operations.com/schematic: "{{ ENV.SCHEMATIC }}"
---
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
  - address: 10.10.99.1
hostDNS:
  enabled: true
  forwardKubeDNSToHost: true
  resolveMemberNames: true
---
apiVersion: v1alpha1
kind: DiscoveryServiceConfig
name: default
endpoint: https://discovery.talos.dev/
---
apiVersion: v1alpha1
kind: DiscoveryIdentityConfig
clusterID: op://infrastructure/talos/CLUSTER_ID
clusterSecret: op://infrastructure/talos/CLUSTER_SECRET
---
apiVersion: v1alpha1
kind: SysctlConfig
params:
  fs.inotify.max_user_instances: "8192"
  fs.inotify.max_user_watches: "1048576"
  net.core.default_qdisc: fq
  net.core.netdev_max_backlog: "50000"
  net.core.rmem_max: "67108864"
  net.core.somaxconn: "65535"
  net.core.wmem_max: "67108864"
  net.ipv4.ip_local_port_range: 1024 65535
  net.ipv4.neigh.default.gc_thresh1: "4096"
  net.ipv4.neigh.default.gc_thresh2: "8192"
  net.ipv4.neigh.default.gc_thresh3: "16384"
  net.ipv4.ping_group_range: 0 2147483647
  net.ipv4.tcp_congestion_control: bbr
  net.ipv4.tcp_fastopen: "3"
  net.ipv4.tcp_fin_timeout: "15"
  net.ipv4.tcp_max_syn_backlog: "65535"
  net.ipv4.tcp_mtu_probing: "1"
  net.ipv4.tcp_notsent_lowat: "131072"
  net.ipv4.tcp_rmem: 4096 87380 33554432
  net.ipv4.tcp_slow_start_after_idle: "0"
  net.ipv4.tcp_tw_reuse: "1"
  net.ipv4.tcp_window_scaling: "1"
  net.ipv4.tcp_wmem: 4096 65536 33554432
  net.ipv6.conf.bond0/1152.accept_ra_defrtr: "0"
  sunrpc.tcp_max_slot_table_entries: "128"
  sunrpc.tcp_slot_table_entries: "128"
  user.max_user_namespaces: "11255"
  vm.nr_hugepages: "1024"
---
apiVersion: v1alpha1
kind: EtcFileConfig
name: nfsmount.conf
mode: 0o644
contents: |
  [ NFSMount_Global_Options ]
  nfsvers=4.2
  hard=True
  noatime=True
  nconnect=8
  rsize=1048576
  wsize=1048576
---
apiVersion: v1alpha1
kind: CRICustomizationConfig
name: containerd
content: |
  [plugins."io.containerd.grpc.v1.cri"]
    enable_unprivileged_ports = true
    enable_unprivileged_icmp = true
  [plugins."io.containerd.cri.v1.images"]
    discard_unpacked_layers = false
  [plugins."io.containerd.cri.v1.runtime"]
    device_ownership_from_security_context = true
---
apiVersion: v1alpha1
kind: SecurityProfileConfig
workloadIsolation: true
---
apiVersion: v1alpha1
kind: KubePrismConfig
port: 7445
---
apiVersion: v1alpha1
kind: FilesystemScrubConfig
interval: 168h0m0s
---
apiVersion: v1alpha1
kind: FilesystemTrimConfig
interval: 168h0m0s
---
apiVersion: v1alpha1
kind: WatchdogTimerConfig
device: /dev/watchdog0
timeout: 5m
---
apiVersion: v1alpha1
kind: KubeNetworkConfig
dnsDomain: cluster.local
podSubnets:
  - 10.42.0.0/16
serviceSubnets:
  - 10.43.0.0/16
---
apiVersion: v1alpha1
kind: BondConfig
name: bond0
links:
  - net0
bondMode: active-backup
---
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.1099
parent: bond0
vlanID: 1099
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: bond0.1099
clientIdentifier: mac
---
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.1152
parent: bond0
vlanID: 1152
