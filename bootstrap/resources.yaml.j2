---
apiVersion: v1
kind: Secret
metadata:
  name: cosign-public-key
  namespace: flux-system
  labels:
    reconcile.external-secrets.io/managed: "true"
data:
  cosign.pub: op://artemis/cosign/COSIGN_PUB_KEY
---
apiVersion: v1
kind: Secret
metadata:
  name: onepassword-connect-credentials-secret
  namespace: external-secrets
stringData:
  1password-credentials.json: 'op://artemis/1password/OP_CREDENTIALS_JSON' # quote
---
apiVersion: v1
kind: Secret
metadata:
  name: onepassword-connect-vault-secret
  namespace: external-secrets
stringData:
  token: op://artemis/access-token/credential
---
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-dns-tunnel-secret
  namespace: network
stringData:
  FROSTLINK_TUNNEL_ID: op://frostlink/cloudflare-frostlink/CLOUDFLARE_TUNNEL_ID
